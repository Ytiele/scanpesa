{
  "_comment": "Menu flows. SIM_TOOLKIT follows the real Safaricom SIM menu (Nov 2026). MPESA_APP and ONE_APP are still APPROXIMATE - tune them with Debug mode (see README). Matching is case-insensitive; punctuation and leading menu numbers ('1.') are ignored; exact matches beat partial ones. {SIM} = SIM slot from Settings. 'optional' steps are skipped when the next step is already on screen.",
  "version": 2,
  "jobTimeoutSeconds": 40,
  "stepTimeoutSeconds": 10,
  "amountLabels": ["amount", "enter amount", "kiasi"],
  "forbiddenButtons": [
    "send", "send now", "pay", "pay now", "confirm", "buy", "submit", "proceed", "complete",
    "authorize", "authorise", "approve", "withdraw", "transfer", "accept and send"
  ],
  "targets": {
    "SIM_TOOLKIT": {
      "_comment": "Menu: Safaricom | M-PESA > Send Money / Withdraw / Buy Airtime / Loans and Savings / Lipa na M-PESA (Pay Bill, Buy Goods, Pochi la Biashara) / My Account. Pay Bill shows 'Search contacts | Enter business number', then 'Search contacts | Account number'.",
      "packages": ["com.android.stk", "com.sec.android.app.stk", "com.mediatek.stk", "com.android.stk2"],
      "packagesSim2": ["com.android.stk2", "com.android.stk", "com.sec.android.app.stk", "com.mediatek.stk"],
      "clearTask": true,
      "loginWaitSeconds": 0,
      "flows": {
        "SEND_MONEY": [
          { "name": "Choose SIM", "action": "click", "texts": ["sim {SIM}", "sim{SIM}", "safaricom"], "optional": true },
          { "name": "M-PESA", "action": "click", "texts": ["m-pesa", "mpesa"] },
          { "name": "Send Money", "action": "click", "texts": ["send money"] },
          { "name": "Enter phone number (menu)", "action": "click", "texts": ["enter phone number", "enter phone no", "enter number", "enter mobile number"], "optional": true },
          { "name": "Enter phone number", "action": "input", "value": "number", "texts": ["enter phone number", "enter phone no", "phone number", "phone no", "mobile number", "enter number"] },
          { "name": "OK after phone", "action": "press", "texts": ["ok", "next", "continue"] },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "PAYBILL": [
          { "name": "Choose SIM", "action": "click", "texts": ["sim {SIM}", "sim{SIM}", "safaricom"], "optional": true },
          { "name": "M-PESA", "action": "click", "texts": ["m-pesa", "mpesa"] },
          { "name": "Lipa na M-PESA", "action": "click", "texts": ["lipa na m-pesa", "lipa na mpesa"] },
          { "name": "Pay Bill", "action": "click", "texts": ["pay bill", "paybill"] },
          { "name": "Enter business number (menu)", "action": "click", "texts": ["enter business number", "enter business no", "business number", "business no"], "optional": true },
          { "name": "Enter business number", "action": "input", "value": "number", "texts": ["enter business number", "enter business no", "business number", "business no"] },
          { "name": "OK after business number", "action": "press", "texts": ["ok", "next", "continue"] },
          { "name": "Account number (menu)", "action": "click", "texts": ["account number", "enter account number", "enter account no", "account no"], "optional": true },
          { "name": "Enter account number", "action": "input", "value": "account", "texts": ["account number", "enter account number", "enter account no", "account no"] },
          { "name": "OK after account number", "action": "press", "texts": ["ok", "next", "continue"] },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "TILL": [
          { "name": "Choose SIM", "action": "click", "texts": ["sim {SIM}", "sim{SIM}", "safaricom"], "optional": true },
          { "name": "M-PESA", "action": "click", "texts": ["m-pesa", "mpesa"] },
          { "name": "Lipa na M-PESA", "action": "click", "texts": ["lipa na m-pesa", "lipa na mpesa"] },
          { "name": "Buy Goods", "action": "click", "texts": ["buy goods", "buy goods and services"] },
          { "name": "Enter till number (menu)", "action": "click", "texts": ["enter till number", "enter till no"], "optional": true },
          { "name": "Enter till number", "action": "input", "value": "number", "texts": ["enter till number", "enter till no", "till number", "till no"] },
          { "name": "OK after till number", "action": "press", "texts": ["ok", "next", "continue"] },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "POCHI": [
          { "name": "Choose SIM", "action": "click", "texts": ["sim {SIM}", "sim{SIM}", "safaricom"], "optional": true },
          { "name": "M-PESA", "action": "click", "texts": ["m-pesa", "mpesa"] },
          { "name": "Lipa na M-PESA", "action": "click", "texts": ["lipa na m-pesa", "lipa na mpesa"] },
          { "name": "Pochi la Biashara", "action": "click", "texts": ["pochi la biashara", "pochi"] },
          { "name": "Enter phone number (menu)", "action": "click", "texts": ["enter phone number", "enter phone no", "enter number"], "optional": true },
          { "name": "Enter phone number", "action": "input", "value": "number", "texts": ["enter phone number", "enter phone no", "phone number", "phone no", "mobile number", "enter number"] },
          { "name": "OK after phone", "action": "press", "texts": ["ok", "next", "continue"] },
          { "name": "Amount screen", "action": "await_amount" }
        ]
      }
    },

    "MPESA_APP": {
      "_comment": "APPROXIMATE - needs a Debug dump from your phone. clearTask=false keeps you logged in; loginWaitSeconds gives you time to unlock with your PIN/fingerprint (ScanPesa never touches it).",
      "packages": ["com.safaricom.mpesa.lifestyle"],
      "clearTask": false,
      "loginWaitSeconds": 45,
      "flows": {
