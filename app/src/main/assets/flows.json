          { "name": "Lipa na M-PESA / Pay", "action": "click", "texts": ["lipa na m-pesa", "lipa na mpesa", "pay"], "optional": true },
          { "name": "Buy Goods / Till", "action": "click", "texts": ["buy goods", "buy goods and services", "till"] },
          { "name": "Till number", "action": "input", "value": "number", "texts": ["till number", "till no", "till"] },
