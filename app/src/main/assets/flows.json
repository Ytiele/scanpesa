          { "name": "Enter phone number", "action": "input", "value": "number", "texts": ["enter phone number", "phone number", "enter number", "mobile number", "search", "name or number", "phone"] },
          { "name": "Continue after number", "action": "press", "texts": ["continue", "next"], "optional": true },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "PAYBILL": [
          { "name": "Pay", "action": "click", "texts": ["pay", "lipa na m-pesa"], "optional": true },
          { "name": "Pay Bill", "action": "click", "texts": ["pay bill", "paybill"] },
          { "name": "Business number", "action": "input", "value": "number", "texts": ["business number", "enter business number", "business no", "paybill number", "search"] },
          { "name": "Continue after business number", "action": "press", "texts": ["continue", "next"], "optional": true },
          { "name": "Account number", "action": "input", "value": "account", "texts": ["account number", "enter account number", "account no", "account"] },
          { "name": "Continue after account", "action": "press", "texts": ["continue", "next"], "optional": true },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "TILL": [
          { "name": "Pay", "action": "click", "texts": ["pay", "lipa na m-pesa"], "optional": true },
          { "name": "Buy Goods", "action": "click", "texts": ["buy goods", "buy goods and services", "till"] },
          { "name": "Till number", "action": "input", "value": "number", "texts": ["till number", "enter till number", "till no", "search", "till"] },
          { "name": "Continue after till", "action": "press", "texts": ["continue", "next"], "optional": true },
          { "name": "Amount screen", "action": "await_amount" }
        ],
        "POCHI": [
          { "name": "Pay", "action": "click", "texts": ["pay", "lipa na m-pesa"], "optional": true },
          { "name": "Pochi la Biashara", "action": "click", "texts": ["pochi la biashara", "pochi"] },
          { "name": "Phone number", "action": "input", "value": "number", "texts": ["phone number", "enter phone number", "mobile number", "search", "phone"] },
          { "name": "Continue after number", "action": "press", "texts": ["continue", "next"], "optional": true },
          { "name": "Amount screen", "action": "await_amount" }
        ]
      }
    },

